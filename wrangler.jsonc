// Cloudflare Workers (static assets) config.
// Deploy with:  npm run deploy   ->  https://lanternfall.<your-subdomain>.workers.dev
// Pages also works: build command "npm run build", output directory "dist".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lanternfall",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
